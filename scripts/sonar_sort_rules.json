{
  "description": "Editable sort rules for Sonar (ssort and the Sort a folder tab). First matching rule wins. dest is relative to the cabinet root unless it starts with 'For Deletion\\\\'. Placeholders: {year}, {person}, {child}, {photo_year}, {you}, {you_folder}. People, children and the cabinet/review roots come from config.json (see config.example.json). Low-confidence or unmatched files go to 00 Inbox. Point dests at the subfolders you approved; add rules for your own bank, brokerage or employer by name.",
  "inbox": "00 Inbox",
  "low_confidence": 0.6,
  "text_only_scale": 0.8,
  "rules": [
    {
      "id": "installers",
      "description": "Windows installers and setup programs",
      "match": {
        "extensions": [
          ".exe",
          ".msi",
          ".msix",
          ".msp",
          ".appx"
        ]
      },
      "match_mode": "all",
      "dest": "For Deletion\\Downloads junk",
      "confidence": 0.95
    },
    {
      "id": "installer_archives",
      "description": "Zip/7z/rar/iso archives that look like installers",
      "match": {
        "extensions": [
          ".zip",
          ".7z",
          ".rar",
          ".iso"
        ],
        "keywords": [
          "setup",
          "installer",
          "install",
          "x64",
          "win64",
          "multilingual",
          "repack",
          "full version"
        ]
      },
      "match_mode": "all",
      "dest": "For Deletion\\Downloads junk",
      "confidence": 0.88
    },
    {
      "id": "tax_forms",
      "description": "Tax forms: W-2, 1099, 1098, 1095, 1040, tax returns",
      "match": {
        "filename_regex": "(?<![0-9])(1099|1098|1095|1040|w-?2)(?![0-9])",
        "keywords": [
          "1099",
          "1098",
          "1095",
          "w-2",
          "w2",
          "1040",
          "tax return",
          "tax form",
          "tax transcript",
          "irs",
          "mortgage interest statement"
        ]
      },
      "match_mode": "any",
      "dest": "40 Money\\Taxes\\{year}_Tax",
      "confidence": 0.92
    },
    {
      "id": "passports",
      "description": "Passport books and passport cards, not passport photos",
      "match": {
        "filename_regex": "passport(?!\\s*photo)",
        "keywords": [
          "passport card",
          "passportbook",
          "passport_card"
        ]
      },
      "match_mode": "any",
      "dest": "10 Identity\\Passports",
      "confidence": 0.9
    },
    {
      "id": "identity_ids",
      "description": "Driver licenses, state IDs, birth certificates, Social Security cards",
      "match": {
        "filename_regex": "(?<![a-z])dl(?![a-z])|drivers?[_ -]?licen[cs]e|state[_ -]?id|birth[_ -]?cert|social[_ -]?security|(?<![a-z])ssn(?![a-z])",
        "keywords": [
          "driver license",
          "drivers license",
          "driver's license",
          "state id",
          "birth certificate",
          "social security",
          "ssn"
        ],
        "use_text": false
      },
      "match_mode": "any",
      "dest": "10 Identity\\IDs",
      "confidence": 0.9
    },
    {
      "id": "insurance_cards",
      "description": "Insurance card scans (front/back), not benefit statements",
      "match": {
        "filename_regex": "insurance[_ -]?card|member[_ -]?id[_ -]?card|_front\\.|_back\\.",
        "keywords": [
          "insurance card",
          "member id card"
        ],
        "use_text": false
      },
      "match_mode": "any",
      "dest": "10 Identity\\Insurance Cards",
      "confidence": 0.86
    },
    {
      "id": "kids_school",
      "description": "School records; needs a child token (Kid1, Kid2) to file under 70 Kids",
      "match": {
        "keywords": [
          "school",
          "report card",
          "student council",
          "iep",
          "pta",
          "homework",
          "classroom",
          "transcript",
          "kindergarten",
          "grade card",
          "parent teacher"
        ]
      },
      "match_mode": "all",
      "dest": "70 Kids\\{child}\\{child}_School",
      "confidence": 0.88,
      "requires": "child"
    },
    {
      "id": "health_records",
      "description": "Medical, dental, vision, pharmacy and lab records for a detected person",
      "match": {
        "keywords": [
          "dental",
